# MatchExec environment (all optional unless noted)

# --- Database ---
# PostgreSQL connection string. In development (NODE_ENV=development) it defaults to the
# compose.dev.yml database below. Unset in the all-in-one Docker image = embedded Postgres.
DATABASE_URL=postgres://matchexec:matchexec@127.0.0.1:5432/matchexec
# pg pool size per process (default 10)
PG_POOL_MAX=10
# Embedded Postgres tuning (all-in-one image only)
PG_SHARED_BUFFERS=128MB
PG_MAX_CONNECTIONS=50
# Where automatic/manual backups are written (default /app/app_data/backups)
MATCHEXEC_BACKUP_DIR=
# Directory holding pg_dump / pg_restore (default: found on the PATH; the Docker image ships them)
# PG_BIN_DIR=
# Set by the all-in-one image's s6 setup (Stage 7); makes automatic backups default to ON. A Unix-socket DATABASE_URL
# (postgresql:///matchexec?host=/run/postgresql) is detected as embedded too. External databases default to OFF.
# MATCHEXEC_EMBEDDED_PG=true
# Upgrade without taking the pre-upgrade dump (only if pg_dump cannot work in your environment)
# MATCHEXEC_SKIP_PREUPGRADE_DUMP=true
# Seconds a restore waits for the bot / scheduler / stats / web processes to finish their current work (default 60000 ms)
# MATCHEXEC_QUIESCE_TIMEOUT_MS=60000
# DEPRECATED: only read by the one-time SQLite importer to find a legacy matchexec.db
# DATABASE_PATH=

# --- Services / deployment ---
# Comma list from web,bot,scheduler,stats,migrate. "all" (default) = every service.
MATCHEXEC_SERVICES=all
# false = services wait for the schema instead of migrating (e.g. Kubernetes, where a Job migrates)
MATCHEXEC_RUN_MIGRATIONS=true
# true = the SQLite importer may apply lossy repairs (skip orphans, null invalid JSON) instead of failing
MATCHEXEC_IMPORT_ALLOW_LOSSY=false

# --- Admin authentication (opt-in) ---
# Setting ADMIN_PASSWORD enables login for every page and /api route.
# Leave unset/empty to keep the app open (default).
ADMIN_PASSWORD=
# HMAC secret for session cookies (defaults to a hash of ADMIN_PASSWORD)
AUTH_SECRET=
# Session lifetime in days (default 7)
AUTH_SESSION_DAYS=7
# Shared token sent as `x-internal-token` by bot/scheduler calling the web API.
# Defaults to sha256("<secret>:internal") when unset.
INTERNAL_API_TOKEN=

# --- Other ---
PUBLIC_URL=http://localhost:3000
TZ=UTC
