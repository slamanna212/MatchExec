#!/command/with-contenv bash
if [ ! -e /run/matchexec/selected/stats ]; then
    echo "[stats] not selected (MATCHEXEC_SERVICES=${MATCHEXEC_SERVICES:-all}), idling"
    s6-svc -O .
    exit 0
fi
if [ -e /run/matchexec/migrate.failed ]; then
    echo "[stats] database migration failed, not starting (see the web UI or the migrate log above)"
    s6-svc -O .
    exit 0
fi

echo "Starting stats processor..."
cd /app
exec s6-setuidgid abc node dist/stats-processor.js
