{
  "name": "matchexec",
  "version": "0.8.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:all-processes && next build --webpack",
    "build:discord-bot": "node esbuild.discord-bot.config.mjs",
    "build:scheduler": "node esbuild.scheduler.config.mjs",
    "build:migrator": "node esbuild.migrator.config.mjs",
    "build:stats-processor": "node esbuild.stats-processor.config.mjs",
    "build:all-processes": "pnpm run build:discord-bot && pnpm run build:scheduler && pnpm run build:migrator && pnpm run build:stats-processor",
    "start": "next start",
    "lint": "eslint .",
    "migrate": "pnpm exec tsx scripts/migrate-background.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "dev:all": "NODE_ENV=development pnpm exec pm2 start ecosystem.config.js",
    "dev:stop": "NODE_ENV=development pnpm exec pm2 stop ecosystem.config.js",
    "dev:restart": "NODE_ENV=development pnpm exec pm2 restart ecosystem.config.js",
    "dev:logs": "pnpm exec pm2 logs",
    "typecheck": "pnpm exec tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:55432/postgres} vitest run tests/integration/server tests/integration/database/pg-",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed",
    "test:unit": "vitest run --exclude='**/integration/**' --exclude='**/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:all": "pnpm run test",
    "prod:start": "pnpm exec pm2 start ecosystem.config.js",
    "prod:stop": "pnpm exec pm2 stop ecosystem.config.js",
    "version": "node scripts/update-helm-version.mjs",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'pnpm run typecheck'"
    ]
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@mantine/core": "9.1.1",
    "@mantine/dates": "9.1.1",
    "@mantine/form": "9.1.1",
    "@mantine/hooks": "9.1.1",
    "@mantine/modals": "9.1.1",
    "@mantine/notifications": "9.1.1",
    "@napi-rs/canvas": "0.1.99",
    "@snazzah/davey": "0.1.11",
    "@tabler/icons-react": "3.44.0",
    "@tailwindcss/vite": "^4.3.3",
    "bufferutil": "4.1.0",
    "discord.js": "14.26.3",
    "drizzle-orm": "^0.45.4",
    "express": "5.2.1",
    "framer-motion": "12.38.0",
    "hono": "^4.13.13",
    "lucide-react": "1.11.0",
    "next": "16.2.4",
    "node-cron": "4.2.1",
    "node-fetch": "3.3.2",
    "pg": "^8.23.1",
    "pm2": "6.0.14",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "^8.5.0",
    "recharts": "^3.8.1",
    "sqlite3": "6.0.1",
    "umzug": "3.8.2",
    "uuid": "14.0.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.2.4",
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "@types/node-cron": "3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@12.6.0"
}
